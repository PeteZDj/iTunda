# iTunda.Web build-time environment variables (Vite)
# Copy to .env for local builds. All VITE_* vars are embedded in the client bundle.

# Google OAuth client ID (public identifier; the secret stays in auth-server).
# Used by src/main.tsx to enable the "Sign in / Sign up with Google" button.
VITE_GOOGLE_CLIENT_ID=355354020888-nmt0qlr55adgprvhaht50oamstv637qs.apps.googleusercontent.com
